<h1>施設登録</h1>

<%= form_with model: @room, local: true do |f| %>
  <% if @room.errors.any? %>
    <div class="alert alert-danger">
      <h4>入力に問題があります:</h4>
      <ul>
        <% @room.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name do %>
      施設名 <span class="text-danger">*</span>
    <% end %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :detail do %>
      施設詳細 <span class="text-danger">*</span>
    <% end %>
    <%= f.text_area :detail, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :price do %>
      料金 <span class="text-danger">*</span>
    <% end %>
    <%= f.number_field :price, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :address do %>
      住所 <span class="text-danger">*</span>
    <% end %>
    <%= f.text_field :address, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :image do %>
      施設画像（任意）
    <% end %>
    <%= f.file_field :image, class: "form-control" %>
  </div>

  <%= f.submit "登録", class: "btn btn-primary" %>
<% end %>
