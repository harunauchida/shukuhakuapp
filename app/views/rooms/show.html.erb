<% if notice %>
  <div class="alert alert-success">
    <%= notice %>
  </div>
<% end %>

<div class="container mt-4">
  <h2 class="mb-3"><%= @room.name.presence || "名称未設定の施設" %></h2>

  <div class="text-center mb-3">
    <% if @room.image.attached? %>
      <%= image_tag @room.image, class: "img-fluid rounded shadow-sm", style: "max-width: 400px;" %>
    <% else %>
      <%= image_tag "default_room.png", class: "img-fluid rounded shadow-sm", style: "max-width: 400px;" %>
    <% end %>
  </div>

  <p><strong>紹介文：</strong><br>
    <%= @room.detail.present? ? simple_format(@room.detail) : "紹介文は登録されていません。" %>
  </p>

  <p><strong>宿泊料金：</strong>
    <%= @room.price.present? ? "#{number_to_currency(@room.price, unit: '¥')} / 日" : "未設定" %>
  </p>

  <div class="mt-4">
    <% if current_user == @room.user %>
      <%= link_to "編集", edit_room_path(@room), class: "btn btn-primary me-2" %>
    <% end %>

    <%= link_to "予約する", new_room_reservation_path(@room), class: "btn btn-success me-2" %>
    <%= link_to "ログインして予約", new_user_session_path, class: "btn btn-secondary me-2" %>
    <%= link_to "← 戻る", (request.referer || rooms_path), class: "btn btn-secondary" %>
  </div>
</div>
