<div class="hero-section d-flex justify-content-center align-items-center text-center"> 
  <h1>haruna.comで
    まだ体験したことのない
    旅をしよう
  </h1>
</div>

<%= form_with url: search_rooms_path, method: :get, local: true do |f| %>
  <div>
    <label>エリア検索：</label>
    <%= f.select :area, [
          ["選択してください", ""],
          ["東京", "東京都"],
          ["大阪", "大阪府"],
          ["京都", "京都府"],
          ["札幌", "札幌市"]
        ] %>
  </div>

  <div>
    <label>フリーワード検索：</label>
    <%= f.text_field :keyword, placeholder: "施設名や詳細を入力" %>
  </div>

  <%= f.submit "検索", class: "btn" %>
<% end %>
