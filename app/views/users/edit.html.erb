<h1>プロフィール</h1>

<div class="profile-container">
  <%= form_with model: @user, url: update_user_profile_path(@user), method: :patch, local: true, multipart: true do |f| %>
    
    <div class="profile-image">
      <% if @user.icon.present? %>
        <%= image_tag @user.icon, width: 100, height: 100 %>
      <% else %>
        <%= image_tag "default_icon.png", width: 100, height: 100 %>
      <% end %>
      <%= f.file_field :icon %>
    </div>

    <div class="profile-info">
      <div>
        <%= f.label :name, "名前" %>
        <%= f.text_field :name %>
      </div>

      <div>
        <%= f.label :profile, "自己紹介" %>
        <%= f.text_area :profile %>
      </div>
    </div>

    <div class="profile-submit">
      <%= f.submit "更新", class: "btn btn-primary" %>
    </div>

  <% end %>
</div>
