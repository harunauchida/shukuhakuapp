<h1><%= @user.name %> さんのプロフィール</h1>
<% if notice %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<div>
  <% if @user.icon.present? %>
    <%= image_tag @user.icon, width: 100, height: 100 %>
  <% else %>
    <%= image_tag "default_icon.png", width: 100, height: 100 %>
  <% end %>
</div>

<p>自己紹介: <%= @user.profile.presence || "未登録" %></p>

<%= link_to "プロフィール編集", edit_user_profile_path(@user), class: "btn btn-primary" %>
<%= link_to "アカウント情報", user_account_path, class: "btn btn-secondary" %>