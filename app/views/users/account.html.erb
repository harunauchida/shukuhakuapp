<h1>アカウント情報</h1>
<% if notice %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>


<p>メールアドレス: <%= @user.email %></p>
<p>パスワード: ********</p>

<%= link_to "アカウント情報を編集", edit_user_account_path, class: "btn btn-primary" %>

<!-- プロフィールページへのリンク -->
<%= link_to "プロフィールを見る", user_path(@user), class: "btn btn-primary" %>