<h2><%= @room.name %> の予約</h2>  
<p>住所: <%= @room.address %></p>
<p>宿泊料金: ¥<%= @room.price %> / 日</p>

<!-- 成功・エラーのメッセージ表示 -->
<% if notice %>
  <div class="alert alert-success">
    <%= notice %>
  </div>
<% end %>

<% if flash[:alert] %>
  <div class="alert alert-danger">
    <%= flash[:alert] %>
  </div>
<% end %>

<%= form_with model: [@room, @reservation], url: confirm_room_reservations_path(@room), local: true do |f| %>
  <div class="mb-3">
    <%= f.label :check_in, "チェックイン日" %>
    <%= f.date_field :check_in, class: "form-control", min: Date.today %>
  </div>

  <div class="mb-3">
    <%= f.label :check_out, "チェックアウト日" %>
    <%= f.date_field :check_out, class: "form-control", min: Date.today + 1 %>
  </div>

  <div class="mb-3">
    <%= f.label :number_of_people, "人数" %>
    <%= f.number_field :number_of_people, min: 1, class: "form-control" %>
  </div>

  <%= f.submit "予約確認へ", class: "btn btn-primary" %>
<% end %>
